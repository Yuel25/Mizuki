{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mizuki",
  "version": "0.3.4",
  "identifier": "app.mizuki.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mizuki",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http://cover.localhost https://lain.bgm.tv https://bgm.tv; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    },
    "enableGTKAppId": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5NDBCQTdBNTM5MzgwNTcKUldSWGdKTlRlcnBBeVZZcGZFN21ZWmZtemhTMS9QeU1lQXhnLzdxaFhCbWdtMCtZZmFRTmNQMlMK",
      "endpoints": ["https://github.com/Yuel25/Mizuki/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
